{
  "uid": "pidea-overview",
  "title": "PIDEA overview",
  "tags": [
    "pidea"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workers alive",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "pidea_workers_alive",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Workers with a heartbeat in the last 60 s. 0 with a non-empty queue means nothing is processing jobs.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "pidea_queue_depth",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Jobs ready to run right now (PENDING or RETRY_SCHEDULED and due).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Oldest waiting job",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "pidea_queue_oldest_age_seconds",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Age of the longest-waiting runnable job.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 120
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stale RUNNING jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "pidea_jobs_stale_running",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Jobs RUNNING longer than the worker stale-claim timeout (15 min): a worker likely died mid-job.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Quarantined (stored)",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "sum(pidea_quarantined_records) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Rejected records currently stored in quarantine.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Metrics data age",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "pidea_metrics_snapshot_age_seconds",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Age of the database snapshot behind the workload panels. Grows if the API cannot reach PostgreSQL.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Jobs by status (current)",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "sum by (status) (pidea_jobs)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Records per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "rate(pidea_records_accepted_total[5m]) * 60",
          "legendFormat": "accepted",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "rate(pidea_records_rejected_total[5m]) * 60",
          "legendFormat": "rejected (quarantined)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "rate(pidea_records_duplicate_total[5m]) * 60",
          "legendFormat": "duplicate",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Quarantine rate (15 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "rate(pidea_records_rejected_total[15m]) / clamp_min(rate(pidea_records_accepted_total[15m]) + rate(pidea_records_rejected_total[15m]) + rate(pidea_records_duplicate_total[15m]), 1e-9)",
          "legendFormat": "rejected share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Quarantined records by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "pidea_quarantined_records",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Average job duration (15 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "rate(pidea_jobs_duration_seconds_total[15m]) / clamp_min(rate(pidea_jobs_completed_total[15m]), 1e-9)",
          "legendFormat": "seconds per job",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Retries scheduled per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "increase(pidea_job_retries_total[1h])",
          "legendFormat": "retries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "API requests per second by status",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"pidea-api\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "API latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"pidea-api\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "pidea-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pidea-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{application=\"pidea-api\",area=\"heap\"})",
          "legendFormat": "heap",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ],
  "description": "Real workload from PostgreSQL (job queue, quarantine, workers) plus API request and JVM metrics."
}
