# Copy to .env and replace every CHANGE_ME. Never commit .env.
POSTGRES_DB=pidea
POSTGRES_USER=pidea_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
PIDEA_DB_PASSWORD=CHANGE_ME_app_password
PIDEA_WORKER_DB_PASSWORD=CHANGE_ME_worker_password
# Optional local host ports (use alternate ports if 5432/8080 are already occupied).
PIDEA_DB_PORT=5432
PIDEA_API_PORT=8080
# Comma-separated exact host allow-list for HTTPS HTTP_API sources; no wildcards.
PIDEA_HTTP_API_ALLOWED_HOSTS=
# Optional Bearer token referenced by source secretRef; do not commit a real value.
PIDEA_HTTP_API_BEARER_TOKEN=
# BCrypt hashes (cost 12) of the API users' passwords. Generate with py -3.12 scripts/new_password_hash.py.
# A user with an empty hash cannot log in.
PIDEA_ADMIN_PASSWORD_HASH=
PIDEA_OPERATOR_PASSWORD_HASH=
PIDEA_VIEWER_PASSWORD_HASH=
# POSTGRES_TABLE connector. Exact "host:port" entries the worker may connect to (comma-separated, no wildcards);
# empty = no database source can be pulled. Source passwords are PIDEA_SRC_* variables referenced by a source's secretRef.
PIDEA_PG_SOURCE_ALLOWED_HOSTS=
# Optional local demo source (docker compose --profile demo up -d demo-source). Use PIDEA_PG_SOURCE_ALLOWED_HOSTS=demo-source:5432.
PIDEA_DEMO_SOURCE_PASSWORD=
# Optional monitoring (docker compose --profile observability up -d). PIDEA_METRICS_PASSWORD must be the plaintext
# password of the read-only "viewer" API user (Prometheus logs in as viewer); GRAFANA_ADMIN_PASSWORD is Grafana's admin password.
PIDEA_METRICS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
PIDEA_PROMETHEUS_PORT=9090
PIDEA_GRAFANA_PORT=3000
# API log format: logstash (JSON, default in Compose) or text.
PIDEA_API_LOG_FORMAT=logstash
# Days to keep submitted raw payloads (customer data) after a job finishes; 0 keeps them forever.
# After this a FAILED records job can no longer be replayed. Expired idempotency keys are always purged.
PIDEA_RAW_RETENTION_DAYS=30
# API database connection pool size (default 10).
PIDEA_DB_POOL_SIZE=10
