# Copy to .env and replace every CHANGE_ME. Never commit .env.
POSTGRES_DB=pidea
POSTGRES_USER=pidea_owner
POSTGRES_PASSWORD=CHANGE_ME_owner_password
PIDEA_DB_PASSWORD=CHANGE_ME_app_password
PIDEA_WORKER_DB_PASSWORD=CHANGE_ME_worker_password
# Optional local host ports (use alternate ports if 5432/8080 are already occupied).
PIDEA_DB_PORT=5432
PIDEA_API_PORT=8080
# Comma-separated exact host allow-list for HTTPS HTTP_API sources; no wildcards.
PIDEA_HTTP_API_ALLOWED_HOSTS=
# Optional Bearer token referenced by source secretRef; do not commit a real value.
PIDEA_HTTP_API_BEARER_TOKEN=
# BCrypt hashes (cost 12) of the API users' passwords. Generate with py -3.12 scripts/new_password_hash.py.
# A user with an empty hash cannot log in.
PIDEA_ADMIN_PASSWORD_HASH=
PIDEA_OPERATOR_PASSWORD_HASH=
PIDEA_VIEWER_PASSWORD_HASH=
